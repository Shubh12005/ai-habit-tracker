# ===================================================
# AI HABIT TRACKER - BACKEND ENVIRONMENT CONFIGURATION
# ===================================================

# Port to bind (Render automatically provides process.env.PORT)
PORT=8000

# Environment mode (production / development)
NODE_ENV=production

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=AiHabbitTracker
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=AiHabbitTracker

# JWT Secret and Expiry
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=30d

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Frontend URL for CORS (comma-separated if multiple, e.g. Vercel domain)
# e.g., https://your-habit-tracker.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Authoritative Single Administrator Email (Case-insensitive)
ADMIN_EMAIL=shubhamnikwade2@gmail.com
